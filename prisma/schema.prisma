generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RankPeriod {
  ALL
  MONTH
  WEEK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChallengeType {
  CODE
  QUIZ
}

model User {
  id              String   @id @default(cuid())
  name            String
  username        String?  @unique
  email           String   @unique
  phone           String?
  passwordHash    String
  bio             String?  @db.Text
  role            String   @default("Full Stack Developer")
  level           Int      @default(1)
  province        String   @default("Toshkent shahri")
  avatar          String?
  primaryCategory String   @default("web")
  score           Int      @default(0)
  rank            Int      @default(0)
  projectsCount   Int      @default(0)
  followersCount  Int      @default(0)
  topPercent      Float    @default(100)
  growth          Int      @default(0)
  online          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills        UserSkill[]
  projects      Project[]
  submissions   Submission[]
  attempts      ChallengeAttempt[]
  rankSnapshots RankSnapshot[]
  messages      Message[]

  @@index([score, createdAt])
  @@index([primaryCategory, score])
}

model Skill {
  id        String     @id @default(cuid())
  name      String     @unique
  category  String
  createdAt DateTime   @default(now())

  users UserSkill[]

  @@index([category])
}

model UserSkill {
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String   @db.Text
  purpose      String   @db.Text
  problem      String   @db.Text
  technologies String[]
  tech         String[] @default([])
  githubUrl    String?
  liveUrl      String?
  stars        Int      @default(0)
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ProjectImage[]

  @@index([userId, createdAt])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String?
  language    String
  code        String           @db.Text
  status      SubmissionStatus @default(PENDING)
  score       Int?
  output      String?          @db.Text
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge?  @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  evaluation Evaluation?

  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
}

model Evaluation {
  id           String   @id @default(cuid())
  submissionId String   @unique
  overall      Int
  correctness  Int      @default(0)
  quality      Int
  security     Int
  speed        Int
  feedback     String   @db.Text
  model        String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Challenge {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  category      String
  type          ChallengeType @default(CODE)
  language      String
  difficulty    String
  description   String        @db.Text
  starterCode   String        @db.Text
  inputExample  String?
  outputExample String?
  tests         Json
  quiz          Json?
  points        Int           @default(100)
  published     Boolean       @default(true)
  createdAt     DateTime      @default(now())

  submissions Submission[]
  attempts    ChallengeAttempt[]

  @@index([category, published, difficulty])
}

model ChallengeAttempt {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  passed      Boolean  @default(false)
  score       Int      @default(0)
  feedback    String?  @db.Text
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
}

model RankSnapshot {
  id         String     @id @default(cuid())
  userId     String
  period     RankPeriod
  score      Int
  rank       Int
  capturedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([period, capturedAt])
  @@index([userId, capturedAt])
}

model News {
  id          String        @id @default(cuid())
  title       String
  summary     String        @db.Text
  content     String        @db.Text
  sourceUrl   String?
  imageUrl    String?
  category    String        @default("IT")
  status      ContentStatus @default(PUBLISHED)
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  location    String?
  eventUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  category    String        @default("Hackathon")
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startsAt])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system")
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}